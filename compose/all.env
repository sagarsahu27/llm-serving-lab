# Overrides for running ALL backends on one GPU at the same time (functional demo only;
# benchmark one backend at a time for fair numbers). Use AFTER compose/.env:
#   docker compose ... --env-file compose/.env --env-file compose/all.env ...
# Budget for a 16 GB T4 with a 1.5B FP16 model (~3.1 GB weights each):
#   vLLM ~0.28 + SGLang ~0.28 + TGI ~0.22 + Ollama (~1.5 GB GGUF) + CUDA contexts.
# Start backends one after another (make up-all does this) so each engine profiles
# memory while the previous ones are already resident.
VLLM_GPU_MEMORY_UTILIZATION=0.28
SGLANG_MEM_FRACTION_STATIC=0.28
TGI_CUDA_MEMORY_FRACTION=0.22
MAX_MODEL_LEN=2048
MAX_INPUT_TOKENS=1536
OLLAMA_NUM_PARALLEL=4

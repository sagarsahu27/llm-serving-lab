# Copy to compose/.env (git-ignored) and adjust.  cp compose/.env.example compose/.env

# --- Model -----------------------------------------------------------------------------
# Hugging Face token: optional for ungated models such as Qwen2.5; required for gated ones.
HF_TOKEN=
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
# Public name in the gateway: <backend>/<MODEL_ALIAS>, e.g. vllm/qwen2.5-1.5b
MODEL_ALIAS=qwen2.5-1.5b
# Ollama serves a quantized GGUF build of the same base model (not apples-to-apples).
OLLAMA_MODEL=qwen2.5:1.5b
# T4 (Turing) has no bf16 support: keep float16. On A100 you may use bfloat16.
DTYPE=float16
MAX_MODEL_LEN=4096
# TGI only: must be < MAX_MODEL_LEN
MAX_INPUT_TOKENS=3072

# --- Images ----------------------------------------------------------------------------
# Pin exact tags once a combination works on your GPU; scripts/run_benchmark.sh records
# the resolved image digests in every report.
VLLM_IMAGE=vllm/vllm-openai:latest
SGLANG_IMAGE=lmsysorg/sglang:latest
TGI_IMAGE=ghcr.io/huggingface/text-generation-inference:3.3.5
OLLAMA_IMAGE=ollama/ollama:latest

# --- GPU memory (single backend on the GPU) --------------------------------------------
# compose/all.env overrides these when all backends share one GPU.
VLLM_GPU_MEMORY_UTILIZATION=0.90
SGLANG_MEM_FRACTION_STATIC=0.85
TGI_CUDA_MEMORY_FRACTION=0.90
OLLAMA_NUM_PARALLEL=16

# --- Extra engine flags ----------------------------------------------------------------
VLLM_EXTRA_ARGS=
# Triton attention is the most portable backend on T4 (sm75); remove on A100/H100.
SGLANG_EXTRA_ARGS=--attention-backend triton
TGI_EXTRA_ARGS=

# --- Gateway ---------------------------------------------------------------------------
GATEWAY_PORT=8000
GATEWAY_FALLBACK_ON_ERROR=false
GATEWAY_READ_TIMEOUT_S=300
LOG_LEVEL=INFO
